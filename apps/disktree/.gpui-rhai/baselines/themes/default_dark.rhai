// Project-owned Default Dark palette: warm graphite, paper ink, cobalt.
// Palettes own colors only; layout tokens live in tokens.rhai.
fn theme() {
    #{
        family: "Default",
        name: "Dark",
        mode: "dark",
        tokens: #{
            colors: #{
                surface_sunken: 0x0d0c0aff,
                surface: 0x151412ff,
                surface_raised: 0x21201eff,
                surface_elevated: 0x2b2a28ff,
                surface_hover: 0x2e2d2bff,
                text_primary: 0xe8e4daff,
                text_muted: 0xbcb7aaff,
                accent: 0x3d5fe0ff,
                accent_hover: 0x3454d4ff,
                on_accent: 0xffffffff,
                danger: 0xef6b5eff,
                on_danger: 0x151412ff,
                warning: 0xe2a640ff,
                on_warning: 0x151412ff,
                success: 0x7cbd78ff,
                on_success: 0x151412ff,
                border_subtle: 0x373633ff,
                border: 0x50504eff,
                border_strong: 0x71716dff,
                focus_ring: 0xe8e4daff,
                selection: 0x141e3bff,
                disabled: 0x737270ff,
                "shadow.ambient": 0x00000052,
                "shadow.key": 0x0000007a,
                "palette.blue": 0x60a5faff, "palette.blue_ink": 0x63a8feff, "palette.blue_soft": 0x2e3b4aff, "palette.blue_border": 0x3b587aff,
                "palette.violet": 0xa78bfaff, "palette.violet_ink": 0xad93ffff, "palette.violet_soft": 0x3c354aff, "palette.violet_border": 0x594d7aff,
                "palette.teal": 0x2dd4bfff, "palette.teal_ink": 0x2dd4bfff, "palette.teal_soft": 0x23443eff, "palette.teal_border": 0x266c62ff,
                "palette.green": 0x4ade80ff, "palette.green_ink": 0x4ade80ff, "palette.green_soft": 0x294632ff, "palette.green_border": 0x327047ff,
                "palette.amber": 0xfbbf24ff, "palette.amber_ink": 0xfbbf24ff, "palette.amber_soft": 0x4d401fff, "palette.amber_border": 0x7d6321ff,
                "palette.rose": 0xfb7185ff, "palette.rose_ink": 0xff788aff, "palette.rose_soft": 0x4d3033ff, "palette.rose_border": 0x7d4249ff,
                "palette.orange": 0xfb923cff, "palette.orange_ink": 0xfb923cff, "palette.orange_soft": 0x4d3724ff, "palette.orange_border": 0x7d502bff,
                "palette.slate": 0x94a3b8ff, "palette.slate_ink": 0x97a7bcff, "palette.slate_soft": 0x383a3dff, "palette.slate_border": 0x51575fff,
            },
        },
    }
}
