// Project-owned Default Light palette: paper, ink, cobalt.
// Palettes own colors only; layout tokens live in tokens.rhai.
fn theme() {
    #{
        family: "Default",
        name: "Light",
        mode: "light",
        tokens: #{
            colors: #{
                surface_sunken: 0xebe9e2ff,
                surface: 0xf3f1eaff,
                surface_raised: 0xfdfbf4ff,
                surface_elevated: 0xfffdf8ff,
                surface_hover: 0xdfddd7ff,
                text_primary: 0x1c1b18ff,
                text_muted: 0x514d44ff,
                accent: 0x1f45b8ff,
                accent_hover: 0x173aacff,
                on_accent: 0xffffffff,
                danger: 0xb3261eff,
                on_danger: 0xffffffff,
                warning: 0x855600ff,
                on_warning: 0xffffffff,
                success: 0x2e6b36ff,
                on_success: 0xffffffff,
                border_subtle: 0xeae8e1ff,
                border: 0xadaca7ff,
                border_strong: 0x878683ff,
                focus_ring: 0x1c1b18ff,
                selection: 0xbdcdeeff,
                disabled: 0x817f7bff,
                "shadow.ambient": 0x0000000d,
                "shadow.key": 0x00000018,
                "palette.blue": 0x2563ebff, "palette.blue_ink": 0x1f5ce3ff, "palette.blue_soft": 0xe3e9f3ff, "palette.blue_border": 0xb4c7f1ff,
                "palette.violet": 0x7c3aedff, "palette.violet_ink": 0x7c39ecff, "palette.violet_soft": 0xeee4f3ff, "palette.violet_border": 0xd1b9f2ff,
                "palette.teal": 0x0d9488ff, "palette.teal_ink": 0x00746bff, "palette.teal_soft": 0xe0efe7ff, "palette.teal_border": 0xabd8cfff,
                "palette.green": 0x10a048ff, "palette.green_ink": 0x007732ff, "palette.green_soft": 0xe1f0dfff, "palette.green_border": 0xacdcbaff,
                "palette.amber": 0xd27300ff, "palette.amber_ink": 0x9d5400ff, "palette.amber_soft": 0xf8ebd7ff, "palette.amber_border": 0xeecda1ff,
                "palette.rose": 0xe11d48ff, "palette.rose_ink": 0xcb003cff, "palette.rose_soft": 0xfae0dfff, "palette.rose_border": 0xf3b0baff,
                "palette.orange": 0xea580cff, "palette.orange_ink": 0xb54000ff, "palette.orange_soft": 0xfbe7d8ff, "palette.orange_border": 0xf7c4a5ff,
                "palette.slate": 0x64748bff, "palette.slate_ink": 0x59687fff, "palette.slate_soft": 0xebebe7ff, "palette.slate_border": 0xc9cdd0ff,
            },
        },
    }
}
