+struct Rows;
+impl ScriptViewExtension for Rows {
+    fn configure_runtime(&self, r: &mut UiRuntimeState) -> Result<(), String> {
+        let rows = (0..1000).map(|i| {
+            BTreeMap::from([
+                ("id".into(), UiValue::String(format!("row-{i}"))),
+                ("a".into(), UiValue::String("Alpha body".into())),
