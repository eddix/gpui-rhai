+        matches!(first.kind(), UiNodeKind::Text { text } if text == "42")
+            && matches!(second.kind(), UiNodeKind::Text { text } if text == "42")
+            && stats
+                .iter()
+                .any(|entry| entry.name == "render_JitProbe" && entry.jit_calls > 0),
+        "{stats:#?}"
+    );
+}
