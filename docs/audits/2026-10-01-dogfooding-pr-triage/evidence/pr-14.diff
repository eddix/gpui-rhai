+            .unwrap();
+        let program = Compiler::new().compile(&ast);
+        let profiler = FunctionProfiler::new();
+        let mut vm = Vm::new(&engine).with_function_accelerator(profiler.accelerator());
+
+        for _ in 0..2 {
