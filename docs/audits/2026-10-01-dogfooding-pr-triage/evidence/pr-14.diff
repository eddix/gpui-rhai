+struct Tracked(Rc<Cell<i64>>);
+
+impl Tracked {
+    fn new(live: &Rc<Cell<i64>>) -> Self {
+        live.set(live.get() + 1);
+        Self(Rc::clone(live))
+    }
+}
+
+impl Clone for Tracked {
+    fn clone(&self) -> Self {
+        Self::new(&self.0)
+    }
+}
+
+impl Drop for Tracked {
+    fn drop(&mut self) {
+        self.0.set(self.0.get() - 1);
+    }
+}
